# ============================================
# KB MASALE ADMIN — PRODUCTION (Vercel)
# ============================================
# This file is committed to git. It is auto-loaded in production builds.
# SECRETS (tokens, keys) must be added in Vercel Dashboard → Settings → Environment Variables.
# Only non-secret config and public URLs go here.

# ─── Data Path ───
KB_DATA_PATH=kb-v4
NEXT_PUBLIC_KB_DATA_PATH=kb-v4

# ─── NextAuth (Production) ───
# CRITICAL: Must match the actual deployed URL + Google OAuth redirect URI
NEXTAUTH_URL=https://kb-masale-admin.vercel.app

# ─── Secrets that MUST be set in Vercel Dashboard ───
# KB_GITHUB_TOKEN=           (GitHub PAT for json-data-keeper read/write)
# KB_VERCEL_TOKEN=            (Vercel token for publish/deploy B2C)
# KB_VERCEL_PROJECT_ID=       (Vercel project ID for B2C app)
# NEXTAUTH_SECRET=            (openssl rand -base64 32)
# GOOGLE_CLIENT_ID=           (Google Cloud Console OAuth)
# GOOGLE_CLIENT_SECRET=       (Google Cloud Console OAuth)
# ALLOWED_ADMIN_EMAILS=       (comma-separated admin emails)
# SUPABASE_URL=              (Supabase project URL — for order management)
# SUPABASE_SERVICE_ROLE_KEY= (Supabase service role key — for order management)
